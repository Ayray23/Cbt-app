# Server-only. Never put this in a VITE_ variable or in cbt-app/public.
# Paste the service-account JSON on ONE line in .env.local / Vercel environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server-only feature release switch. Keep false until LAN pilot + backup restore +
# approval. When enabled, set VITE_ENABLE_LAN=true on the matching frontend.
CBT_ENABLE_LAN=false
