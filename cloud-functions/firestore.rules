rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() && exists(currentUserPath());
    }

    function role() {
      return userExists() ? get(currentUserPath()).data.role : null;
    }

    function isAdmin() {
      return role() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return role() == 'superadmin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );

      // Users may create only student profiles. Admins may provision student
      // profiles for accounts created through the secondary Firebase Auth app.
      allow create: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == 'student')
        ) ||
        (isAdmin() && request.resource.data.role == 'student')
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          resource.data.role == 'student' &&
          request.resource.data.role == resource.data.role
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'photoUrl',
            'phone',
            'preferences',
            'lastLoginAt',
            'lastLogin',
            'lastSeen',
            'updatedAt'
          ])
        )
      );

      allow delete: if isSuperAdmin();
    }

    match /exams/{examId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.status == 'published'
      );

      allow create, update, delete: if isAdmin();
    }

    match /examAccess/{examId} {
      allow read, write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.status == 'published'
      );

      allow create, update, delete: if isAdmin();
    }

    // Student-readable validation records contain only a hash, never the
    // plaintext code printed on the candidate's slip.
    match /studentExamCodeHashes/{codeId} {
      allow get: if isSignedIn() && (
        isAdmin() || resource.data.studentUid == request.auth.uid
      );
      allow list: if isAdmin();

      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.studentUid == request.auth.uid &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'used' &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.codeHash == resource.data.codeHash &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'usedAt',
          'updatedAt'
        ])
      );
    }

    // Plaintext codes and printable student details are strictly admin-only.
    match /studentExamCodePrintRecords/{codeId} {
      allow read, write: if isAdmin();
    }

    match /examSessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && resource.data.studentUid == request.auth.uid) ||
        sessionId.matches('.*_' + request.auth.uid)
      );

      allow create: if isSignedIn() && (
        isAdmin() || request.resource.data.studentUid == request.auth.uid
      );

      allow update: if isSignedIn() && (
        isAdmin() || resource.data.studentUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}