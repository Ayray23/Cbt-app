rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function enabled() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('loginDisabled', false) == false; }
    function admin() { return enabled() && profile().role in ['admin', 'superadmin']; }
    function examiner() { return enabled() && profile().role in ['admin', 'superadmin', 'examofficer']; }
    function invigilator() { return enabled() && profile().role in ['admin', 'superadmin', 'examofficer', 'invigilator']; }
    function teacher() { return enabled() && profile().role == 'teacher'; }
    function draftOwner(examId) {
      let exam = get(/databases/$(database)/documents/exams/$(examId)).data;
      return exam.status == 'draft' && (examiner() || (teacher() && exam.createdBy == request.auth.uid && exam.className in profile().assignedClasses && exam.subject in profile().assignedSubjects));
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || invigilator());
      allow write: if false;
    }
    match /exams/{id} {
      allow read: if enabled() && (invigilator() || (teacher() && resource.data.createdBy == request.auth.uid) || (profile().role == 'student' && resource.data.status == 'published'));
      allow create, delete: if false;
      allow update: if examiner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'questionCount']) && request.resource.data.status == 'draft';
    }
    match /questions/{id} {
      allow read: if examiner() || (teacher() && resource.data.createdBy == request.auth.uid);
      allow create: if draftOwner(request.resource.data.examId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.resource.data.examId == resource.data.examId && request.resource.data.createdBy == resource.data.createdBy && draftOwner(resource.data.examId);
      allow delete: if draftOwner(resource.data.examId);
    }
    match /examAssignments/{id} { allow read: if invigilator() || (enabled() && resource.data.studentUid == request.auth.uid); allow write: if false; }
    match /examSessions/{id} { allow read: if invigilator() || (enabled() && resource.data.studentUid == request.auth.uid && resource.data.schemaVersion == 2); allow write: if false; }
    match /examResults/{id} { allow read: if examiner() || (enabled() && resource.data.studentUid == request.auth.uid && resource.data.get('released', false) == true); allow write: if false; }
    match /school/{id} { allow read: if enabled(); allow write: if false; }
    match /auditLogs/{id} { allow read: if examiner(); allow write: if false; }
    match /examAccess/{id} { allow read, delete: if admin(); allow create, update: if false; }
    match /examPins/{id} { allow read, write: if false; }
    match /examPapers/{id} { allow read, write: if false; }
    match /examSessionProofs/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
