rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function enabled() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profile().get('loginDisabled', false) == false;
    }
    function isAdmin() { return enabled() && profile().role in ['admin', 'superadmin']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Account provisioning, access settings and role changes go through the verified API.
      allow write: if false;
    }
    match /exams/{examId} {
      allow read: if enabled() && (isAdmin() || resource.data.status == 'published');
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin() &&
        (request.resource.data.status != 'published' || resource.data.status == 'published') &&
        request.resource.data.get('paperVersion', null) == resource.data.get('paperVersion', null);
      allow delete: if isAdmin();
    }
    match /questions/{questionId} {
      // Answer keys are never readable by a student, even for a published exam.
      allow read, write: if isAdmin();
    }
    match /examAssignments/{assignmentId} {
      allow read: if isAdmin() || (enabled() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }
    match /examSessions/{sessionId} {
      allow read: if isAdmin() || (
        enabled() && resource.data.studentUid == request.auth.uid &&
        resource.data.schemaVersion == 2
      );
      // The API checks PINs, preserves deadlines and owns all session writes.
      allow write: if false;
    }
    match /examResults/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /examAccess/{examId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    match /examPins/{id} { allow read, write: if false; }
    match /examPapers/{id} { allow read, write: if false; }
    match /examSessionProofs/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
