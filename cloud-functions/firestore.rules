rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() && exists(currentUserPath());
    }

    function role() {
      return userExists() ? get(currentUserPath()).data.role : null;
    }

    function isAdmin() {
      return role() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return role() == 'superadmin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'student')) ||
        (isAdmin() && request.resource.data.role == 'student')
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && resource.data.role == 'student' && request.resource.data.role == resource.data.role) ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'photoUrl', 'phone', 'preferences', 'lastLoginAt', 'lastLogin', 'lastSeen', 'updatedAt'
        ]))
      );
      allow delete: if isSuperAdmin();
    }

    match /exams/{examId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    match /examAccess/{examId} {
      allow read, write: if isAdmin();
    }

    match /questions/{questionId} {
      // Legacy client exam loading remains temporarily allowed for published exams.
      // The secure getExamQuestions callable is available for the final client migration.
      allow read: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.status == 'published'
      );
      allow create, update, delete: if isAdmin();
    }

    match /studentExamCodeHashes/{codeId} {
      allow get: if isSignedIn() && isAdmin();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /studentExamCodePrintRecords/{codeId} {
      allow read, write: if isAdmin();
    }

    match /examSessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && resource.data.studentUid == request.auth.uid) ||
        sessionId.matches('.*_' + request.auth.uid)
      );

      allow create: if isSignedIn() && isAdmin();

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.studentUid == request.auth.uid &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.examId == resource.data.examId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'tabSwitchCount', 'integrityWarnings', 'lastHeartbeatAtMs',
            'networkOnline', 'lastVisibilityChangeAtMs', 'lastSavedAt', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
