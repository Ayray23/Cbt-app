{
  "name": "cbt-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/build-icons.mjs",
    "prebuild": "node ../scripts/build-icons.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config ../cloud-functions/firebase.json --project demo-cbt-school --only firestore \"node --test tests/emulator/*.test.mjs\"",
    "test:browser": "firebase emulators:exec --config ../cloud-functions/firebase.json --project demo-cbt-school --only auth,firestore \"node tests/browser/school-flow.mjs\"",
    "test:api": "firebase emulators:exec --config ../cloud-functions/firebase.json --project demo-cbt-school --only auth,firestore \"node --test tests/api/*.test.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "firebase": "^12.6.0",
    "firebase-admin": "^14.5.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.35.0",
    "globals": "^16.5.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=22"
  }
}
